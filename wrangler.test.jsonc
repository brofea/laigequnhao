{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laigequnhao-test",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // 本文件只供自动化测试使用。未设置 remote，D1/R2 均由 workerd 本地模拟。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lgqh-test-local",
      // Local-only Miniflare sentinel; this is not a Cloudflare resource ID.
      "database_id": "00000000-0000-4000-8000-000000000002",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "lgqh-test-local",
    },
  ],
  "vars": {
    "SECURE_COOKIE": "true",
  },
}
