{
  "name": "laigequnhao",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vue-tsc --build --force && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pages:dev": "wrangler pages dev --proxy 5173 -- vite dev",
    "pages:deploy": "wrangler pages deploy ./dist",
    "db:migrate:local": "wrangler d1 execute laigequnhao-db --local --file=migrations/0001_initial.sql",
    "db:migrate:preview": "wrangler d1 execute laigequnhao-preview --file=migrations/0001_initial.sql",
    "db:migrate:prod": "wrangler d1 execute laigequnhao-prod --file=migrations/0001_initial.sql",
    "db:reset:local": "wrangler d1 execute laigequnhao-db --local --command=\"DROP TABLE IF EXISTS rate_limits; DROP TABLE IF EXISTS likes; DROP TABLE IF EXISTS submission_details; DROP TABLE IF EXISTS join_methods; DROP TABLE IF EXISTS group_tags; DROP TABLE IF EXISTS groups;\"",
    "db:seed:local": "wrangler d1 execute laigequnhao-db --local --file=migrations/seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20251221.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/forms": "^0.5.9",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.0.0",
    "zod": "^3.24.0"
  }
}
