{
  "name": "laigequnhao",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite dev",
    "vite:dev": "vite dev --mode frontend-only",
    "worker:dev": "node scripts/worker-dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --build --force && tsc -p functions/tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "wrangler d1 migrations apply lgqh-dev --local --config wrangler.jsonc --persist-to .wrangler/state",
    "db:migrate:remote": "node scripts/migrate-remote.mjs",
    "seed": "node scripts/seed.mjs",
    "clean": "node scripts/clean.mjs",
    "deploy": "node scripts/deploy.mjs",
    "release": "pnpm build && pnpm deploy",
    "cloudflare:check": "node scripts/cloudflare-resources.mjs --check",
    "db:test:migrate": "wrangler d1 migrations apply lgqh-test-local --local --config wrangler.test.jsonc",
    "db:test:reset": "wrangler d1 execute lgqh-test-local --local --config wrangler.test.jsonc --command=\"DROP TABLE IF EXISTS rate_limits; DROP TABLE IF EXISTS likes; DROP TABLE IF EXISTS submission_details; DROP TABLE IF EXISTS join_methods; DROP TABLE IF EXISTS group_tags; DROP TABLE IF EXISTS assets; DROP TABLE IF EXISTS groups;\"",
    "db:test:unlock": "wrangler d1 execute lgqh-test-local --local --config wrangler.test.jsonc --command=\"DELETE FROM rate_limits;\""
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "hono": "^4.6.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20251221.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/forms": "^0.5.9",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "jsqr": "^1.4.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.118.0",
    "zod": "^3.24.0"
  }
}
