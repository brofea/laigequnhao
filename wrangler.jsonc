{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laigequnhao",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare Vite Plugin fills in assets.directory in its generated
  // wrangler.json. Keeping only routing here accepts the plugin's official
  // client output (including dist/client) instead of hard-coding a folder.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // 本地开发由 Cloudflare Vite Plugin / Wrangler 使用本地 D1/R2 模拟。
  // 不写入 database_id，避免把部署者账号的资源 ID 固化到源配置。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lgqh-dev",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "lgqh-dev",
    },
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "SKIP_TURNSTILE": "true",
    "SECURE_COOKIE": "false",
  },
  "env": {
    "preview": {
      "name": "laigequnhao-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "laigequnhao-preview",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "laigequnhao-assets-preview",
        },
      ],
      "vars": {
        "ENVIRONMENT": "preview",
        "SKIP_TURNSTILE": "true",
        "SECURE_COOKIE": "true",
      },
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "laigequnhao-prod",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "laigequnhao-assets-prod",
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SKIP_TURNSTILE": "false",
        "SECURE_COOKIE": "true",
      },
    },
  },
}
