{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laigequnhao",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare Vite Plugin fills in assets.directory in its generated
  // wrangler.json. Keeping only routing here accepts the plugin's official
  // client output (including dist/client) instead of hard-coding a folder.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // 本地开发由 Cloudflare Vite Plugin / Wrangler 使用本地 D1/R2 模拟。
  // 不写入 database_id，避免把部署者账号的资源 ID 固化到源配置。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lgqh-dev",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "lgqh-dev",
    },
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "SECURE_COOKIE": "false",
    "SUBMISSION_LIMIT_PER_HOUR": "1",
  },
  "env": {
    // pnpm dev 由 vite.config.ts 设置 CLOUDFLARE_ENV=develop 加载此环境。
    // 部署流程（scripts/deploy.mjs）不读取 env 区块，生产 vars 由部署脚本硬编码。
    "develop": {
      // wrangler 环境区块不继承顶层 D1/R2 绑定，必须显式声明（本地模拟库）。
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lgqh-dev",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "lgqh-dev",
        },
      ],
      "vars": {
        "ENVIRONMENT": "develop",
        "SECURE_COOKIE": "false",
        "SUBMISSION_LIMIT_PER_HOUR": "10000",
      },
    },
  },
}
