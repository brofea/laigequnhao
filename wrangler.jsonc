{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laigequnhao",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare Vite Plugin fills in assets.directory in its generated
  // wrangler.json. Keeping only routing here accepts the plugin's official
  // client output (including dist/client) instead of hard-coding a folder.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // 本地开发由 Cloudflare Vite Plugin / Wrangler 使用本地 D1/R2 模拟。
  // 不写入 database_id，避免把部署者账号的资源 ID 固化到源配置。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lgqh-dev",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "lgqh-dev",
    },
  ],
  // 环境变量分布：pnpm dev 使用 env.develop；生产部署由
  // scripts/cloudflare-resources.mjs 整体替换 vars；无顶层 vars（裸跑用代码默认值）。
  "env": {
    "develop": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lgqh-dev",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "lgqh-dev",
        },
      ],
      "vars": {
        "ENVIRONMENT": "develop",
        "SECURE_COOKIE": "false",
        "SUBMISSION_LIMIT_PER_HOUR": "10000",
        "LIKE_LIMIT_PER_TEN_MINUTE": "100",
      },
    },
  },
}
